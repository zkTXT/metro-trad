# Copiez ce fichier en « .env.local » puis renseignez vos valeurs.
# .env.local n'est jamais versionné.

# Emails d'identification pour MyMemory (moteur de traduction de secours),
# séparés par des virgules. Chaque email a son quota quotidien de traduction.
MYMEMORY_EMAILS=vous@exemple.com,autre@exemple.com

# (Facultatif) Azure Translator : moteur officiel, utilisé en premier s'il est configuré.
# Niveau gratuit F0 : 2 millions de caractères par mois (un compte Azure est requis).
# Créez une ressource « Translator », choisissez le niveau « Free F0 », puis copiez la
# clé et la région (« Clés et point de terminaison » dans le portail Azure).
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=westeurope
